    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
